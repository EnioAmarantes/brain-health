API_IMAGE=ghcr.io/enioamarantes/brain-health-api:staging-latest
FRONTEND_IMAGE=ghcr.io/enioamarantes/brain-health-frontend:staging-latest

# Banco (MARIADB_USER/MARIADB_PASSWORD criam o usuario de aplicacao no primeiro init;
# em volume ja existente, crie o usuario manualmente — ver README)
MYSQL_ROOT_PASSWORD=change-me
MARIADB_USER=brainhealth
MARIADB_PASSWORD=change-me
MYSQL_DATABASE=BrainHealthDb

# Grafana (obrigatorio em staging/producao)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ASPNETCORE_URLS=http://+:5000
CONNECTION_STRING=Server=db;Port=3306;Database=BrainHealthDb;User=brainhealth;Password=change-me;SslMode=None;AllowLoadLocalInfile=false;AllowPublicKeyRetrieval=true;
